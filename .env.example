# Copy to .env (optional) or set these in your shell / Render dashboard.
PORT=3000
NODE_ENV=development
# Path to the SQLite database file. Use :memory: for a throwaway database.
DATABASE_PATH=./data/musician-finder.db
# Number of demo musicians created when the database is empty (0 to disable).
SEED_COUNT=60
# Set to "false" to stop the server from calling the Zippopotam.us API for unknown ZIP codes.
ZIP_LOOKUP_ENABLED=true
